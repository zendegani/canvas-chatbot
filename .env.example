# OpenRouter API Key (for AI chat — stored per-user in browser localStorage)
# This is NOT needed for auth; it's used for the canvas chat feature.
VITE_WEB3FORMS_KEY=your_access_key_here

# ─── Default Models (fallback when no API key is set yet) ───
VITE_DEFAULT_MODEL_OPENROUTER=google/gemma-3-27b-it
VITE_DEFAULT_MODEL_OPENAI=gpt-5.4-mini
VITE_DEFAULT_MODEL_GOOGLE=gemini-3-flash-preview

# ─── Better-Auth (set these in Vercel Dashboard → Environment Variables) ───
# These are server-side only; they are NEVER exposed to the browser.
DATABASE_URL=postgresql://user:password@host:6543/postgres
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_API_KEY=your_better_auth_api_key

# ─── OAuth Providers ───
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
