# ─── Client-side (Vite — VITE_* vars are exposed to the browser) ───────────

# Optional: Web3Forms key for the landing-page contact form.
VITE_WEB3FORMS_KEY=your_web3forms_access_key

# Default model used when a provider has no API key set yet.
VITE_DEFAULT_MODEL_OPENROUTER=google/gemma-3-27b-it
VITE_DEFAULT_MODEL_OPENAI=gpt-5.4-mini
VITE_DEFAULT_MODEL_GOOGLE=gemini-3-flash-preview
VITE_DEFAULT_MODEL_MINIMAX=MiniMax-M2.7

# ─── Better-Auth (server-side; never exposed to the browser) ───────────────

DATABASE_URL=postgresql://user:password@host:6543/postgres
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_API_KEY=your_better_auth_api_key

# ─── OAuth providers (server-side) ─────────────────────────────────────────

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ─── Vercel ────────────────────────────────────────────────────────────────
# Auto-written by `vercel link` / `vercel dev` — don't set this by hand.
# Listed here so cloners know it'll appear in their .env.local automatically.
# VERCEL_OIDC_TOKEN=

# ─── Phoenix tracing (optional) ────────────────────────────────────────────
# Server-side fallback. Users can override these per-session from
# Settings → Tracing in the UI; leave unset for production deploys.

# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
# PHOENIX_API_KEY=
# PHOENIX_PROJECT_NAME=canvas-ai

# ─── scripts/test-tavily.ts (standalone end-to-end test) ───────────────────
# Used only by `npx tsx scripts/test-tavily.ts`. Not read by the app itself.

TAVILY_API_KEY=tvly-...
OPENROUTER_API_KEY=sk-or-v1-...
# Alternative providers for the test script (set any one):
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=AIza...
# MINIMAX_API_KEY=sk-cp-...
# MINIMAX_GROUP_ID=        # required alongside MINIMAX_API_KEY
